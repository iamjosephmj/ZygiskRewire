<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal prompt ">_" foreground: the project's dark-ops identity.
     Strokes sit inside the 66dp adaptive-icon safe zone (viewport 108x108). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- ">" prompt chevron -->
    <path
        android:pathData="M40,38 L54,54 L40,70"
        android:strokeColor="#00E676"
        android:strokeWidth="7"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter" />
    <!-- "_" cursor underscore -->
    <path
        android:pathData="M60,70 L74,70"
        android:strokeColor="#00E676"
        android:strokeWidth="7"
        android:strokeLineCap="square" />
</vector>
