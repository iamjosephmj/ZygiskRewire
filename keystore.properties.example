# Copy this file to `keystore.properties` at the repository root (it is
# gitignored) to sign release APK builds with your own keystore. If the file
# is absent, release builds automatically fall back to the debug signing
# config so ad-hoc builds remain installable.
#
# Generate a keystore first:
#   keytool -genkeypair -v -keystore release.keystore -alias zygiskrewire \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# `storeFile` is interpreted relative to the repository root.

storeFile=release.keystore
storePassword=your-store-password
keyAlias=zygiskrewire
keyPassword=your-key-password
